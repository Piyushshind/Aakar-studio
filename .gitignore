# Image pipeline: owner's original client photos (backup lives in the owner's Google Drive)
src/haveToProcessImages/
# New originals dropped in for processing (client photos): never committed.
scripts/new_added_photos/
# Image pipeline: generated working files (contact sheets of client photos, reports)
scripts/images/out/
# Website photo masters (src/assets/photos/) ARE committed since 2026-10-31, so Vercel can build
# from the public repo (the owner and the families gave consent for the website). Kept out: the
# unpublished _review images and the excluded album page with the old logo and phone number.
src/assets/photos/_review/
src/assets/photos/albums/wedding-01/wedding-01-06.webp

# Safety net, the repo is public: camera originals, camera RAW files, layered edits and archives
# are ignored wherever they land. Only the logo assets in public/ and src/assets/brand/ may be
# JPEGs (og-image.jpg). PNG and WebP are not listed: the logo PNGs and the WebP website photos
# are tracked on purpose.
*.jpg
*.jpeg
*.JPG
*.JPEG
*.heic
*.heif
*.HEIC
*.tif
*.tiff
*.cr2
*.cr3
*.nef
*.arw
*.dng
*.raf
*.orf
*.rw2
*.psd
*.zip
!public/**/*.jpg
!src/assets/brand/**/*.jpg
# Logo reference: banner photo with a baby in it; never committed while the repo is public.
# (After the line above, so it stays ignored.)
src/assets/brand/reference-banner.jpg

# Python (scripts/brand/outline_text.py)
__pycache__/
*.pyc

# Deploy CLIs (spec 15: Netlify or Cloudflare from a local build)
.netlify/
.wrangler/

# Measurement output: Lighthouse reports, DevTools traces and profiles
.lighthouseci/
lighthouse-report*
*.report.html
Trace-*.json
*.cpuprofile
*.heapsnapshot

