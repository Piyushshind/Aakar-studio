# Copy to .env.local for local overrides.

# Consent gate (spec 6): 'true' hides child and private-event photos whose consent is not confirmed.
# Development keeps it 'false' so every photo shows with a "consent pending" badge.
# The launch build MUST use VITE_ENFORCE_CONSENT=true.
VITE_ENFORCE_CONSENT=false

# Contact form (spec 5, item 17): optional override for the Web3Forms access key. The studio's key
# is already in src/lib/inquiry.ts (it is public by design), so leave this empty unless you want
# the form to send to a different Web3Forms form, e.g. for testing.
VITE_WEB3FORMS_KEY=
