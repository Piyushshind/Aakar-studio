{
  "name": "aakar-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.ts --outDir node_modules/.cache/aakar-ssr && node scripts/prerender.mjs",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "images:analyze": "node scripts/images/analyze.mjs",
    "images:dedupe": "node scripts/images/dedupe.mjs",
    "images:sheets": "node scripts/images/contact-sheets.mjs",
    "images:classify": "node scripts/images/classify.mjs",
    "images:export": "node scripts/images/export.mjs",
    "images:report": "node scripts/images/report.mjs",
    "images:add": "node scripts/images/add-new.mjs",
    "brand:build": "node --disable-warning=ExperimentalWarning scripts/brand/build.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.9.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.57.0",
    "motion": "^14.3.0",
    "react": "^19.2.8",
    "react-compare-slider": "^4.0.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.90.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "yet-another-react-lightbox": "^3.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-imagetools": "^12.0.1"
  }
}
